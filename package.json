{
  "name": "ofortuna",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @ofortuna/web dev",
    "dev:marketing": "pnpm --filter @ofortuna/marketing dev"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "2.8.20",
    "typescript": "5.9.3"
  }
}
