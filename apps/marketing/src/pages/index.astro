---
import { Button } from "@ofortuna/ui/components/ui/button";
import "../styles/globals.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ofortuna Marketing</title>
  </head>
  <body>
    <main class="flex min-h-screen items-center justify-center px-6 py-24">
      <section class="max-w-3xl space-y-6 text-center">
        <p class="text-sm font-medium uppercase tracking-[0.3em] text-muted-foreground">Ofortuna Marketing</p>
        <h1 class="font-serif text-5xl tracking-tight text-foreground sm:text-6xl">Astro is ready to render shared shadcn components.</h1>
        <p class="text-lg leading-8 text-muted-foreground">The marketing app now shares the same UI package as the web app, so your landing pages can use the same design primitives from day one.</p>
        <div class="flex items-center justify-center gap-3">
          <Button>Shared shadcn button</Button>
          <Button variant="outline">Marketing is wired</Button>
        </div>
      </section>
    </main>
  </body>
</html>
