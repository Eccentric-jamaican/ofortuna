---
import { buttonVariants } from "@ofortuna/ui/components/ui/button";
import { Badge } from "@ofortuna/ui/components/ui/badge";
import {
  Sparkles,
  ArrowDown,
  CheckCircle2,
  LayoutDashboard,
  FileText,
  Clock,
  ArrowRight,
  UserRound
} from "lucide-react";
---

<section id="product" class="relative min-h-[100dvh] flex flex-col items-center justify-center overflow-hidden grain-overlay">
  <!-- Ambient Background Gradients -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] bg-gradient-to-b from-primary/[0.04] via-transparent to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-gradient-to-tl from-accent/20 via-transparent to-transparent rounded-full blur-3xl animate-pulse-glow"></div>
    <div class="absolute top-1/3 left-0 w-[400px] h-[400px] bg-gradient-to-br from-primary/[0.03] to-transparent rounded-full blur-3xl"></div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: linear-gradient(rgba(0,0,0,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.1) 1px, transparent 1px); background-size: 64px 64px;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-8 w-full z-10 pt-16 lg:pt-20 pb-12 lg:pb-16">
    <!-- Centralized Messaging -->
    <div class="text-center max-w-5xl mx-auto mb-7 lg:mb-8">
      <Badge className="mb-6 font-headline text-xs font-bold tracking-widest uppercase px-5 py-2 bg-primary text-primary-foreground animate-fade-up rounded-full shadow-md">Join the waitlist</Badge>

      <h1 class="font-headline text-4xl sm:text-5xl md:text-[3.75rem] lg:text-[4.5rem] font-extrabold tracking-[-0.04em] leading-[1.04] mb-4 text-foreground animate-fade-up-delay-1">
        Organize business setup.<br /><span class="bg-gradient-to-r from-primary via-primary to-primary/80 bg-clip-text text-transparent">Coordinate legal work.</span>
      </h1>

      <p class="text-base md:text-lg text-muted-foreground leading-relaxed mb-7 max-w-3xl mx-auto font-light animate-fade-up-delay-2">
        Ofortuna gives founders and legal professionals a shared workspace for structured intake, record management, and better-prepared matters.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center animate-fade-up-delay-3">
        <a href="#pricing" class={buttonVariants({ size: "lg", className: "px-8 h-13 font-headline font-bold text-[15px] shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-300 rounded-lg" })}>
          Start your matter today
          <ArrowRight className="w-4 h-4 ml-2" />
        </a>
        <a href="#resources" class={buttonVariants({ size: "lg", variant: "outline", className: "px-8 h-13 font-headline font-semibold text-[15px] hover:bg-muted/50 transition-all duration-300 rounded-lg" })}>View Demo</a>
      </div>
    </div>

    <!-- Product Preview with Floating Panels -->
    <div class="relative max-w-5xl mx-auto animate-fade-up-delay-3">
      <!-- AI-Guided Intake Floating Card -->
      <div class="absolute -top-8 -left-4 lg:-left-16 z-20 w-72 md:w-80 glass-panel editorial-shadow-lg rounded-xl p-6 border border-white/60 hidden lg:block">
        <div class="flex items-center gap-3 mb-5 pb-4 border-b border-black/[0.04]">
          <div class="w-8 h-8 rounded-md bg-primary/[0.08] border border-primary/15 flex items-center justify-center">
            <Sparkles className="w-4 h-4 text-primary" strokeWidth={1.9} />
          </div>
          <span class="font-headline font-bold text-[10px] tracking-[0.15em] uppercase text-muted-foreground">AI-Guided Intake</span>
        </div>
        <div class="space-y-3">
          <div class="p-3 bg-muted/50 rounded-lg text-[11px] text-muted-foreground italic leading-relaxed">
            "I want to start a tech company in Delaware with three co-founders..."
          </div>
          <div class="flex justify-center">
            <div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center">
              <ArrowDown className="w-3 h-3 text-primary" />
            </div>
          </div>
          <div class="p-4 bg-gradient-to-br from-primary-container/40 to-primary-container/20 border border-primary/8 rounded-lg">
            <h4 class="font-headline font-bold text-[11px] text-on-primary-container mb-2.5">Matter: "Project Atlas"</h4>
            <ul class="text-[10px] space-y-2 text-foreground/80">
              <li class="flex items-center gap-2">
                <CheckCircle2 className="w-3.5 h-3.5 text-primary" strokeWidth={1.9} />
                Entity Type: C-Corp
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 className="w-3.5 h-3.5 text-primary" strokeWidth={1.9} />
                Jurisdiction: Delaware
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Main Dashboard Preview -->
      <div class="relative rounded-xl overflow-hidden editorial-shadow-lg bg-white border border-black/[0.06] md:scale-[1.02]">
        <!-- Top Chrome Bar -->
        <div class="h-10 bg-gradient-to-b from-muted/80 to-muted/40 border-b border-black/[0.04] flex items-center px-4 gap-2">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-black/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black/10"></div>
          </div>
          <div class="flex-1 flex justify-center">
            <div class="h-4 w-48 bg-black/[0.04] rounded-sm"></div>
          </div>
        </div>
        <div class="flex h-[460px] md:h-[540px]">
          <!-- Sidebar -->
          <aside class="w-52 border-r border-black/[0.04] p-5 space-y-6 hidden md:block bg-muted/20">
            <div class="space-y-3">
              <div class="flex items-center gap-2.5 p-2 rounded-md bg-primary/5">
                <div class="w-5 h-5 rounded bg-primary/15 border border-primary/20 flex items-center justify-center">
                  <LayoutDashboard className="w-3 h-3 text-primary" strokeWidth={1.9} />
                </div>
                <div class="h-1.5 w-16 bg-primary/20 rounded-full"></div>
              </div>
              <div class="flex items-center gap-2.5 p-2 rounded-md hover:bg-muted/30 transition-colors">
                <div class="w-5 h-5 rounded-sm bg-black/[0.04]"></div>
                <div class="h-1.5 w-20 bg-black/[0.06] rounded-full"></div>
              </div>
              <div class="flex items-center gap-2.5 p-2 rounded-md hover:bg-muted/30 transition-colors">
                <div class="w-5 h-5 rounded-sm bg-black/[0.04]"></div>
                <div class="h-1.5 w-14 bg-black/[0.06] rounded-full"></div>
              </div>
            </div>
            <div class="border-t border-black/[0.04] pt-5 space-y-3">
              <div class="h-1.5 w-12 bg-black/[0.06] rounded-full ml-2"></div>
              <div class="flex items-center gap-2.5 p-2">
                <div class="w-5 h-5 rounded-sm bg-black/[0.04]"></div>
                <div class="h-1.5 w-24 bg-black/[0.06] rounded-full"></div>
              </div>
            </div>
          </aside>
          <!-- Main Content -->
          <div class="flex-1 flex flex-col">
            <header class="h-14 border-b border-black/[0.04] flex items-center px-6 justify-between bg-white">
              <div class="flex items-center gap-3">
                <span class="text-[13px] font-headline font-bold text-foreground">Matter: Seed Round 2024</span>
                <span class="px-2.5 py-0.5 rounded-md bg-green-50 text-green-700 text-[9px] font-bold tracking-wider uppercase border border-green-200/60">Active</span>
              </div>
              <div class="flex gap-2 items-center">
                <div class="w-7 h-7 rounded-full border border-black/10 bg-gradient-to-b from-white to-slate-100 flex items-center justify-center overflow-hidden">
                  <UserRound className="w-3.5 h-3.5 text-slate-500" strokeWidth={1.8} />
                </div>
                <div class="w-7 h-7 rounded-full border border-black/10 bg-gradient-to-b from-white to-stone-100 flex items-center justify-center -ml-2 ring-2 ring-white overflow-hidden">
                  <UserRound className="w-3.5 h-3.5 text-stone-500" strokeWidth={1.8} />
                </div>
              </div>
            </header>
            <main class="flex-1 p-6 grid grid-cols-1 md:grid-cols-3 gap-5 bg-muted/10">
              <div class="md:col-span-2 space-y-5 rounded-lg bg-white/70 border border-black/[0.04] p-4 md:p-5">
                <div class="grid grid-cols-2 gap-4 pb-4 border-b border-black/[0.05]">
                  <div class="pr-3 border-r border-black/[0.05]">
                    <span class="text-[9px] font-bold uppercase tracking-wider text-muted-foreground mb-1.5 block">Completion</span>
                    <div class="text-3xl font-headline font-extrabold text-primary tracking-tight">78%</div>
                    <div class="mt-3 h-1 bg-muted rounded-full overflow-hidden"><div class="h-full w-[78%] bg-gradient-to-r from-primary to-primary/80 rounded-full"></div></div>
                  </div>
                  <div class="pl-1">
                    <span class="text-[9px] font-bold uppercase tracking-wider text-muted-foreground mb-1.5 block">Next Step</span>
                    <div class="text-[13px] font-semibold text-foreground leading-snug">Board Consent Review</div>
                    <div class="mt-3 flex items-center gap-1.5 text-primary text-[10px] font-medium">
                      <Clock className="w-3 h-3" strokeWidth={1.9} /> Due in 3 days
                    </div>
                  </div>
                </div>
                <div class="space-y-3 pt-1">
                  <h4 class="font-headline font-bold text-[12px] text-foreground">Recent Documents</h4>
                  <div class="py-2.5 px-1 flex justify-between items-center border-y border-black/[0.05]">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-md bg-primary/[0.07] border border-primary/15 flex items-center justify-center">
                        <FileText className="w-4 h-4 text-primary" strokeWidth={1.9} />
                      </div>
                      <div>
                        <span class="text-[11px] font-medium text-foreground block">Bylaws_Draft_v3.pdf</span>
                        <span class="text-[9px] text-muted-foreground">Updated by Elena Lopez</span>
                      </div>
                    </div>
                    <span class="text-[9px] text-muted-foreground bg-muted/50 px-2 py-0.5 rounded-md">2h ago</span>
                  </div>
                </div>
              </div>
              <div class="hidden md:block border-l border-black/[0.05] pl-4">
                <h4 class="font-headline font-bold text-[12px] text-foreground mb-4">Stakeholders</h4>
                <div class="space-y-1">
                  <div class="flex items-center gap-3 py-2.5">
                    <div class="w-9 h-9 rounded-full border border-black/10 bg-gradient-to-b from-white to-slate-100 flex items-center justify-center">
                      <UserRound className="w-4 h-4 text-slate-500" strokeWidth={1.8} />
                    </div>
                    <div>
                      <div class="text-[11px] font-semibold text-foreground">John Smith</div>
                      <div class="text-[9px] text-muted-foreground">Lead Founder</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 py-2.5 border-t border-black/[0.05]">
                    <div class="w-9 h-9 rounded-full border border-black/10 bg-gradient-to-b from-white to-stone-100 flex items-center justify-center">
                      <UserRound className="w-4 h-4 text-stone-500" strokeWidth={1.8} />
                    </div>
                    <div>
                      <div class="text-[11px] font-semibold text-foreground">Elena Lopez</div>
                      <div class="text-[9px] text-muted-foreground">Legal Counsel</div>
                    </div>
                  </div>
                </div>
              </div>
            </main>
          </div>
        </div>
      </div>

      <!-- Ambient Glow Under Dashboard -->
      <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[80%] h-40 bg-gradient-to-t from-primary/[0.05] to-transparent blur-3xl -z-10"></div>
    </div>
  </div>
</section>
