---
import { buttonVariants } from "@ofortuna/ui/components/ui/button";

const navItems = [
  { label: "Overview", href: "#product" },
  { label: "Industries", href: "#solutions" },
  { label: "Benefits", href: "#resources" },
  { label: "Waitlist", href: "#pricing" },
];
---

<nav class="fixed top-0 w-full z-50 glass-panel border-b border-black/[0.04] transition-all duration-500">
  <div class="flex justify-between items-center max-w-7xl mx-auto px-8 h-[72px]">
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/Ofortuna logo.svg" alt="Ofortuna" class="h-12 w-auto" />
      </a>
      <div class="hidden md:flex gap-1">
        {navItems.map((item) => (
          <a
            class="px-4 py-2 rounded-md font-headline font-semibold text-[13px] text-muted-foreground transition-all duration-200 hover:text-foreground hover:bg-muted/50"
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-3">
      <a href="#pricing" class={buttonVariants({ variant: "ghost", className: "font-headline font-semibold text-[13px] h-9 rounded-md" })}>Log in</a>
      <a href="#pricing" class={buttonVariants({ className: "font-headline font-semibold text-[13px] h-9 shadow-sm hover:shadow-md transition-shadow rounded-md" })}>Get Started</a>
    </div>
  </div>
</nav>
